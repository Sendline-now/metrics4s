          "editorMode": "code",
          "expr": "sum by (outcome) (rate(processor_items_total{namespace=\"$namespace\", service=~\"$service\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ]
    },
